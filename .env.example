# RevenueOS environment variables. Copy to .env.local and fill in.
# Names are documented in .claude/knowledge/engineering/README.md. NEVER commit real values.

# MongoDB Atlas
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="revenueos"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Claude (Anthropic)
ANTHROPIC_API_KEY="sk-ant-..."

# Knowledge (Notion) — optional for M1
NOTION_API_KEY=""

# Email (Resend) — optional for M1
RESEND_API_KEY=""

# Storage (Cloudinary) — optional for M1
CLOUDINARY_URL=""

# Observability — optional for M1
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# DNS resolver override (optional). Set ONLY if `mongodb+srv://` fails with
# `querySrv ECONNREFUSED`. Comma-separated. Leave unset where DNS works (Vercel).
DNS_SERVERS="8.8.8.8,1.1.1.1"

# --- Knowledge engine (Part 1-3) ---
# Qdrant = semantic memory. Without it, documents are stored (pending) but not searchable.
QDRANT_URL=""
QDRANT_API_KEY=""
# Voyage AI embeddings (Anthropic's recommended). Without it, a NON-semantic dev fallback is used.
VOYAGE_API_KEY=""
EMBEDDING_MODEL="voyage-3-large"
EMBEDDING_DIM="1024"

# --- Security (Part 10) ---
# AES-256-GCM key for connector secrets (OAuth refresh tokens). 32 bytes hex: `openssl rand -hex 32`.
APP_ENCRYPTION_KEY=""

# --- Google connector (Part 4) — OAuth 2.0, NOT API keys ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to {BETTER_AUTH_URL}/api/connectors/google/oauth/callback
GOOGLE_REDIRECT_URI=""

# --- Owner bootstrap (one-time: `npm run bootstrap-owner`) ---
# NEVER commit real values. The Owner is the highest authority (role "owner", perms "*").
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_NAME="Owner"
ORG_NAME="Svayantra Tech"
ORG_ID="default"
